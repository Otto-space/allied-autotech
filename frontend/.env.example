# Server-only origin. Browser requests always use same-origin /api/v1.
BACKEND_ORIGIN=http://127.0.0.1:5000

# Keep disabled for development and staging. Enabling requires an approved
# production domain and the release checks in docs/implementation-status.md.
SITE_INDEXING=disabled

# Public build-time hostname allowlist for approved product/vehicle image storage.
# Comma-separated bare HTTPS hostnames, without paths, wildcards or credentials.
# Leave empty until the real media hosting origin is confirmed.
NEXT_PUBLIC_MEDIA_HOSTS=

# Optional local browser-test target (never use a production URL for mutation tests).
PLAYWRIGHT_BASE_URL=http://localhost:3000
