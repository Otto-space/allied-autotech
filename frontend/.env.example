# Server-only origin. Browser requests always use same-origin /api/v1.
# Leave BACKEND_ORIGIN unset in Vercel to preview the frontend without a backend.
# On Vercel, use a reachable HTTPS backend origin or a tunnel URL to your local API.
# Do not include an /api/v1 suffix. The backend can stay in local development mode.
# Localhost is only for local development. See docs/vercel-deployment.md.
BACKEND_ORIGIN=http://127.0.0.1:5000

# Keep disabled for development and staging. Enabling requires an approved
# production domain and the release checks in docs/implementation-status.md.
SITE_INDEXING=disabled

# Approved production HTTPS origin only, with no path, query or credentials.
# Leave empty until confirmed. Missing/invalid configuration keeps indexing off.
# Server runtime setting; never derive canonical links from incoming Host headers.
SITE_ORIGIN=

# Public build-time hostname allowlist for approved product/vehicle image storage.
# Comma-separated bare HTTPS hostnames, without paths, wildcards or credentials.
# Leave empty until the real media hosting origin is confirmed.
NEXT_PUBLIC_MEDIA_HOSTS=

# Runtime allowlist for private uploads/downloads. Comma-separated bare HTTPS
# storage hostnames only; these names are public configuration, not credentials.
# Must match backend object storage and its CORS policy. Empty disables transfers.
ASSET_STORAGE_HOSTS=

# Optional local browser-test target (never use a production URL for mutation tests).
PLAYWRIGHT_BASE_URL=http://localhost:3000
