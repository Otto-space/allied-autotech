# Enter these in Vercel's Production environment; do not upload a local env file.
# Replace both example origins with your actual hosted frontend and API origins.
BACKEND_ORIGIN=https://api.example.com
SITE_ORIGIN=https://www.example.com

# Enable only when the approved production domain is ready for public discovery.
SITE_INDEXING=disabled

# Optional bare storage hostnames, comma-separated. Never include storage secrets.
NEXT_PUBLIC_MEDIA_HOSTS=
ASSET_STORAGE_HOSTS=

# Optional browser key, restricted to Maps Embed API and your frontend referrers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
