        "http_path": "/api/v1/health/ready",
        "initial_delay_seconds": 15,
        "period_seconds": 10,
        "timeout_seconds": 5,
        "success_threshold": 1,
        "failure_threshold": 6
      },
      "liveness_health_check": {
        "http_path": "/api/v1/health/live",
