# Review-only production plan. Missing real production credentials/digests deliberately prevent deployment.
{
  "name": "allied-autotech-production",
  "region": "lon",
  "databases": [
    {
      "name": "production-postgres",
      "engine": "PG",
      "production": true,
      "cluster_name": "allied-autotech-staging-db",
      "db_name": "allied_autotech_production",
      "db_user": "allied_production_runtime"
    }
  ],
  "alerts": [
    {
      "rule": "DEPLOYMENT_FAILED"
    },
    {
      "rule": "DOMAIN_FAILED"
    }
  ],
