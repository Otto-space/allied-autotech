# Review template only. Replace every REPLACE_* value in a private deployment copy.
# The intentionally invalid digest placeholders prevent accidental deployment.
name: allied-autotech-staging
region: REPLACE_DO_REGION

alerts:
  - rule: DEPLOYMENT_FAILED
  - rule: DOMAIN_FAILED

databases:
  - name: staging-db
    engine: PG
    version: "17"
    production: true
    cluster_name: REPLACE_STAGING_POSTGRES_CLUSTER
    db_name: REPLACE_STAGING_DATABASE_NAME
    db_user: REPLACE_STAGING_DATABASE_USER

services:
  - name: api
    image:
      registry_type: DOCR
      repository: allied-autotech-backend-api
      digest: sha256:REPLACE_API_REGISTRY_DIGEST
    http_port: 5000
    instance_count: 1
    instance_size_slug: REPLACE_API_INSTANCE_SIZE_SLUG
    health_check:
      http_path: /api/v1/health/ready
      initial_delay_seconds: 15
      period_seconds: 10
      timeout_seconds: 5
      success_threshold: 1
      failure_threshold: 6
    liveness_health_check:
      http_path: /api/v1/health/live
      initial_delay_seconds: 20
      period_seconds: 30
      timeout_seconds: 5
      failure_threshold: 3
    termination:
      drain_seconds: 15
      grace_period_seconds: 30
    envs:
      - key: NODE_ENV
        value: production
        scope: RUN_TIME
        type: GENERAL
      - key: DEPLOYMENT_ENV
        value: staging
        scope: RUN_TIME
        type: GENERAL
      - key: SERVICE_NAME
        value: allied-autotech-staging-api
        scope: RUN_TIME
        type: GENERAL
      - key: PORT
        value: "5000"
        scope: RUN_TIME
        type: GENERAL
      - key: FRONTEND_URL
        value: https://REPLACE_STAGING_FRONTEND_HOST
        scope: RUN_TIME
        type: GENERAL
      - key: TRUST_PROXY_HOPS
        value: "1"
        scope: RUN_TIME
        type: GENERAL
      - key: LOG_LEVEL
        value: info
        scope: RUN_TIME
        type: GENERAL
      - key: REQUEST_BODY_LIMIT
        value: 100kb
        scope: RUN_TIME
        type: GENERAL
      - key: READINESS_TIMEOUT_MS
        value: "2000"
        scope: RUN_TIME
        type: GENERAL
      - key: GLOBAL_RATE_LIMIT
        value: "300"
        scope: RUN_TIME
        type: GENERAL
      - key: GLOBAL_RATE_WINDOW_MS
        value: "900000"
        scope: RUN_TIME
        type: GENERAL
      - key: API_DOCS_ENABLED
        value: "false"
        scope: RUN_TIME
        type: GENERAL
      - key: DB_HOST
        value: ${staging-db.HOSTNAME}
        scope: RUN_TIME
        type: GENERAL
      - key: DB_PORT
        value: ${staging-db.PORT}
        scope: RUN_TIME
