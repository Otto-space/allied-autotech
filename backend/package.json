{
  "name": "backend",
  "version": "1.0.0",
  "description": "Secure REST API and worker backend for Allied AutoTech.",
  "main": "dist/server.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:migrations": "tsx scripts/verify-migrations.ts",
    "test:db:create": "tsx scripts/create-test-database.ts",
    "test:db:drop": "tsx scripts/drop-test-database.ts",
    "check:db-tls": "tsx scripts/verify-database-tls.ts",
    "check": "npm run check:secrets && npm run check:prisma && npm run typecheck && npm run check:scripts && npm run check:openapi && npm run check:routes && npm run lint && npm run format:check && npm test && npm run check:prisma-config",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "check:secrets:history": "tsx scripts/check-secrets.ts --history",
    "check:prisma": "npm run db:check",
    "check:prisma-config": "tsc --noEmit --ignoreConfig --module NodeNext --moduleResolution NodeNext --target esnext --esModuleInterop true --types node prisma.config.ts",
    "check:scripts": "tsc -p tsconfig.scripts.json",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "check:openapi": "tsx scripts/validate-openapi.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests scripts vitest.config.ts prisma.config.ts",
    "format": "prettier --write src tests scripts *.ts *.json",
    "format:check": "prettier --check src tests scripts *.ts *.json",
    "predev": "npm run db:check && npm run prisma:generate",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run prisma:generate",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker:identity": "tsx src/workers/outbox.worker.ts",
    "preworker:identity": "npm run db:check",
    "identity:worker": "npm run worker:identity",
    "worker:general": "tsx src/workers/worker-runtime.ts",
    "preworker:general": "npm run db:check",
    "bootstrap:super-admin": "tsx scripts/bootstrap-admin.ts",
    "db:check": "tsx scripts/check-database-safety.ts",
    "db:backup": "tsx scripts/backup-database.ts",
    "db:migrate": "tsx scripts/migrate-safely.ts",
    "db:recover:initial": "tsx scripts/recover-initial-migration.ts",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "phase7:preflight": "tsx scripts/verify-phase7-preflight.ts",
    "reconcile:payments": "tsx scripts/reconcile-payments.ts",
    "seed:staging:public": "tsx scripts/seed-staging-public.ts",
    "check:routes": "tsx scripts/verify-route-coverage.ts"
  },
  "keywords": [
    "automotive",
    "express",
    "postgresql",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@simplewebauthn/server": "^14.0.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "otplib": "^13.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "oxlint": "^1.81.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "mysql2": "3.24.3"
  }
}
