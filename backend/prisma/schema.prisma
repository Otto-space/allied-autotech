  REFUND
  CHARGEBACK
  REVERSAL
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum ReconciliationStatus {
  RUNNING
  MATCHED
  DIFFERENCES_FOUND
  FAILED
}

enum ReconciliationItemStatus {
  MATCHED
  MISSING_IN_PROVIDER
  MISSING_LOCALLY
  AMOUNT_MISMATCH
  CURRENCY_MISMATCH
  STATUS_MISMATCH
}

enum VehicleListingStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  INACTIVE
  ARCHIVED
}

enum VehicleTransactionStatus {
  ENQUIRY
  INSPECTION_SCHEDULED
  INSPECTION_COMPLETED
  NEGOTIATING
  PAYMENT_PENDING
  RESERVED
  PARTIALLY_PAID
  PAID
  HANDOVER_PENDING
  COMPLETED
  CANCELLED
  EXPIRED
}

enum InspectionStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  RESCHEDULED
  CANCELLED
  NO_SHOW
}

enum VehicleDocumentType {
  OWNERSHIP
  REGISTRATION
  CUSTOMS_CLEARANCE
  PURCHASE_RECEIPT
  INSPECTION_REPORT
  SERVICE_HISTORY
  OTHER
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum VehicleHandoverStatus {
  PENDING
  READY
  COMPLETED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewTargetType {
  BUSINESS
  PRODUCT
  SERVICE
  ORDER
  VEHICLE_TRANSACTION
}

enum EnquiryType {
  GENERAL
  PRODUCT
  VEHICLE
  SERVICE
  BOOKING
  QUOTATION
}

enum EnquiryStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ComplaintStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum NotificationType {
  BOOKING
  QUOTATION
  WORK_ORDER
  ORDER
  PAYMENT
  REFUND
  DISPUTE
  INSPECTION
  VEHICLE_TRANSACTION
  ENQUIRY
  COMPLAINT
  REVIEW
  PROMOTION
  SYSTEM
}

enum NotificationCategory {
  SECURITY
  TRANSACTIONAL
  OPERATIONAL
  MARKETING
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum SupportMessageVisibility {
  CUSTOMER
  INTERNAL
}

enum SupportMessageAuthorType {
  CUSTOMER
  STAFF
  SYSTEM
}

enum Transmission {
  AUTOMATIC
  MANUAL
  CVT
  OTHER
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  OTHER
}

enum VehicleCondition {
  NEW
  USED
}

enum BodyType {
  SEDAN
  SUV
  COUPE
  HATCHBACK
  WAGON
  PICKUP
  VAN
  TRUCK
  BUS
  OTHER
}

enum DriveType {
  FWD
  RWD
  AWD
  FOUR_WD
  OTHER
}

enum AuditAction {
  READ
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_RESET
  EMAIL_VERIFIED
  MFA_ENABLED
  MFA_DISABLED
  ROLE_CHANGE
  ACCOUNT_SUSPENDED
  ACCOUNT_DEACTIVATED
  SESSION_REVOKED
  STATUS_CHANGE
  INVENTORY_ADJUSTED
  PAYMENT_INITIALIZED
  PAYMENT_VERIFIED
  MANUAL_PAYMENT_APPROVED
  REFUND_REQUESTED
  REFUND_APPROVED
  PAYMENT_REFUNDED
  DISPUTE_UPDATED
  VEHICLE_RESERVED
  VEHICLE_RELEASED
  INVITATION_CREATED
  INVITATION_ACCEPTED
  BRANCH_ASSIGNED
}

enum AuditEntityType {
  USER
  BRANCH
  PRIVILEGED_INVITATION
  SESSION
  MFA_FACTOR
  CUSTOMER_PROFILE
  STAFF_PROFILE
  CUSTOMER_VEHICLE
  SERVICE
  BOOKING_SLOT
  BOOKING
  QUOTE
  WORK_ORDER
  PRODUCT
  INVENTORY
  ORDER
  PAYMENT
  PAYMENT_ATTEMPT
  REFUND
  DISPUTE
  VEHICLE
  VEHICLE_LISTING
  VEHICLE_TRANSACTION
  INSPECTION
  REVIEW
  ENQUIRY
  COMPLAINT
  PROMOTION
  INVOICE
}

enum InventoryTransactionType {
  STOCK_IN
  SALE
  RESERVATION
  RESERVATION_RELEASE
  RETURN
  ADJUSTMENT
  DAMAGE
  RESTOCK
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  DEAD_LETTER
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.Citext
  passwordHash String
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)

  emailVerifiedAt     DateTime?
  passwordChangedAt   DateTime?
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  profile                   CustomerProfile?
  staffProfile              StaffProfile?
  sessions                  Session[]
  passwordResetTokens       PasswordResetToken[]
  emailVerificationTokens   EmailVerificationToken[]
  mfaFactors                MfaFactor[]
  mfaRecoveryCodes          MfaRecoveryCode[]
  mfaChallenges             MfaChallenge[]
  auditLogs                 AuditLog[]
  notifications             Notification[]
  notificationPreferences   NotificationPreference[]
  supportMessages           SupportMessage[]
  reviewsModerated          Review[]                          @relation("ReviewModerator")
  inventoryTransactions     InventoryTransaction[]
  manualPaymentsSubmitted   ManualPaymentReview[]             @relation("ManualPaymentSubmitter")
  manualPaymentsReviewed    ManualPaymentReview[]             @relation("ManualPaymentReviewer")
  refundsRequested          Refund[]                          @relation("RefundRequester")
  refundsApproved           Refund[]                          @relation("RefundApprover")
  anomaliesResolved         PaymentAnomaly[]                  @relation("AnomalyResolver")
  vehicleStatusChanges      VehicleTransactionStatusHistory[]
  idempotencyRecords        IdempotencyRecord[]
  privilegedInvitationsSent PrivilegedInvitation[]            @relation("PrivilegedInvitationInviter")

  @@index([role])
  @@index([status])
  @@index([lockedUntil])
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique @db.VarChar(128)
  csrfTokenHash String?   @db.Char(64)
  expiresAt     DateTime
  idleExpiresAt DateTime  @default(now())
  lastUsedAt    DateTime?
  lastRotatedAt DateTime  @default(now())
  revokedAt     DateTime?
  mfaRequired   Boolean   @default(false)
  mfaVerifiedAt DateTime?
  ipAddress     String?   @db.Inet
  userAgent     String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mfaChallenges MfaChallenge[]

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([idleExpiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model MfaFactor {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid
  type            MfaFactorType
  status          MfaFactorStatus @default(PENDING)
  name            String?         @db.VarChar(100)
  encryptedSecret Bytes?
  encryptionKeyId String?         @db.VarChar(120)
  credentialId    String?         @unique @db.VarChar(500)
  publicKey       Bytes?
  signCount       BigInt?         @default(0)
  verifiedAt      DateTime?
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique @db.VarChar(128)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model MfaChallenge {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @db.Uuid
  sessionId     String              @db.Uuid
  purpose       MfaChallengePurpose
  challengeHash String              @unique @db.Char(64)
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime            @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@index([sessionId, purpose, expiresAt])
}

model AuthenticationThrottle {
  id           String    @id @default(uuid()) @db.Uuid
  keyHash      String    @unique @db.Char(64)
  failedCount  Int       @default(0)
  blockedUntil DateTime?
  lastFailedAt DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([blockedUntil])
  @@index([expiresAt])
}

model AuditLog {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String?         @db.Uuid
  action     AuditAction
  entityType AuditEntityType
  entityId   String?
  requestId  String?         @db.VarChar(100)
  oldValues  Json?
  newValues  Json?
  ipAddress  String?         @db.Inet
  userAgent  String?         @db.Text
  createdAt  DateTime        @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([requestId])
  @@index([createdAt])
}

model StaffProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  branchId  String?  @db.Uuid
  firstName String
  lastName  String
  phone     String?  @db.VarChar(32)
  jobTitle  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch              Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignedBookings    Booking[]             @relation("AssignedBookings")
  bookingSlots        BookingSlot[]
  assignedEnquiries   Enquiry[]             @relation("AssignedEnquiries")
  assignedComplaints  Complaint[]           @relation("AssignedComplaints")
  assignedInspections InspectionRequest[]   @relation("AssignedInspections")
  quotesCreated       ServiceQuote[]
  vehiclePriceChanges VehiclePriceHistory[]
  documentsReviewed   VehicleDocument[]
  handoversHandled    VehicleHandover[]

  @@index([branchId])
  @@index([jobTitle])
}

model CustomerProfile {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  firstName       String
  lastName        String
  phone           String    @db.VarChar(32)
  phoneVerifiedAt DateTime?
  address         String?
  city            String?
  state           String?
  country         String    @default("Nigeria")
  avatarUrl       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerVehicles      CustomerVehicle[]
  bookings              Booking[]
  cart                  Cart?
  orders                Order[]
  payments              Payment[]
  vehicleTransactions   VehicleTransaction[]
  inspectionRequests    InspectionRequest[]
  reviews               Review[]
  enquiries             Enquiry[]
  complaints            Complaint[]
  invoices              Invoice[]
  savedVehicles         SavedVehicle[]
  productFavourites     ProductFavourite[]
  inventoryReservations InventoryReservation[]

  @@index([phone])
  @@index([state])
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.Citext
  name      String
  phone     String?  @db.VarChar(32)
  email     String?  @db.Citext
  address   String
  city      String
  state     String
  country   String   @default("Nigeria")
  timezone  String   @default("Africa/Lagos") @db.VarChar(64)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff                 StaffProfile[]
  enquiries             Enquiry[]
  complaints            Complaint[]
  vehicles              Vehicle[]
  listings              VehicleListing[]
  inventories           Inventory[]
  bookings              Booking[]
  bookingSlots          BookingSlot[]
  orders                Order[]
  privilegedInvitations PrivilegedInvitation[]

  @@index([isActive])
  @@index([state, city])
}

model PrivilegedInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @db.Citext
  role        UserRole
  branchId    String?   @db.Uuid
  tokenHash   String    @unique @db.VarChar(128)
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  invitedById String    @db.Uuid
  createdAt   DateTime  @default(now())

  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  invitedBy User    @relation("PrivilegedInvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([email])
  @@index([expiresAt])
  @@index([invitedById])
  @@index([branchId])
}

model CustomerVehicle {
  id                 String   @id @default(uuid()) @db.Uuid
  customerId         String   @db.Uuid
  make               String
  model              String
  year               Int
  registrationNumber String?
  vin                String?  @unique
  color              String?
  mileageKm          Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([customerId])
  @@index([registrationNumber])
  @@index([make, model])
}

model Service {
  id               String             @id @default(uuid()) @db.Uuid
  name             String
  slug             String             @unique
  description      String?
  shortDescription String?
  pricingType      ServicePricingType @default(FIXED)
  priceKobo        BigInt?
  currency         String             @default("NGN") @db.Char(3)
  durationMinutes  Int?
  isActive         Boolean            @default(true)
  version          Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  bookings     Booking[]
  bookingSlots BookingSlot[]
  reviews      Review[]
  enquiries    Enquiry[]

  @@index([isActive])
  @@index([pricingType, isActive])
}

model BookingSlot {
  id        String            @id @default(uuid()) @db.Uuid
  branchId  String            @db.Uuid
  serviceId String            @db.Uuid
  staffId   String            @db.Uuid
  startsAt  DateTime
  endsAt    DateTime
  status    BookingSlotStatus @default(OPEN)
  version   Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  branch   Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  service  Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff    StaffProfile @relation(fields: [staffId], references: [id], onDelete: Restrict)
  bookings Booking[]

  @@index([serviceId, branchId, status, startsAt])
  @@index([staffId, startsAt, endsAt])
  @@index([status, startsAt])
}

model Booking {
  id                      String                       @id @default(uuid()) @db.Uuid
  customerId              String                       @db.Uuid
  branchId                String?                      @db.Uuid
  serviceId               String                       @db.Uuid
  vehicleId               String?                      @db.Uuid
  assignedStaffId         String?                      @db.Uuid
  bookingSlotId           String?                      @db.Uuid
  scheduledAt             DateTime
  status                  BookingStatus                @default(REQUESTED)
  quotedPriceKobo         BigInt?
  currency                String                       @default("NGN") @db.Char(3)
  customerNotes           String?
  staffNotes              String?
  cancellationReason      String?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  confirmedAt             DateTime?
  startedAt               DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  paymentHoldExpiresAt    DateTime?
  depositBaseKobo         BigInt?
  depositBasisPoints      Int?
  depositAmountKobo       BigInt?
  depositPolicyVersion    String?                      @db.VarChar(80)
  depositTermsAcceptedAt  DateTime?
  depositPaidAt           DateTime?
  depositForfeitedAt      DateTime?
  customerRescheduleCount Int                          @default(0)
  scheduleVersion         Int                          @default(0)
  disruptionRequestedAt   DateTime?
  disruptionReason        String?
  disruptionResolution    BookingDisruptionResolution?
  version                 Int                          @default(0)

  customer       CustomerProfile   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch         Branch?           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  service        Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  vehicle        CustomerVehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  assignedStaff  StaffProfile?     @relation("AssignedBookings", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  bookingSlot    BookingSlot?      @relation(fields: [bookingSlotId], references: [id], onDelete: Restrict)
  depositPayment Payment?
  reminders      BookingReminder[]
  quotes         ServiceQuote[]
  workOrder      WorkOrder?
  enquiries      Enquiry[]
  review         Review?
  invoice        Invoice?
  complaints     Complaint[]

  @@index([serviceId])
  @@index([branchId, status, scheduledAt])
  @@index([vehicleId])
  @@index([status, scheduledAt])
  @@index([assignedStaffId, status, scheduledAt])
  @@index([bookingSlotId, status])
  @@index([status, paymentHoldExpiresAt])
  @@index([customerId, status])
  @@index([customerId, createdAt])
}

model BookingReminder {
  id              String                @id @default(uuid()) @db.Uuid
  bookingId       String                @db.Uuid
  kind            BookingReminderKind
  scheduledFor    DateTime
  scheduleVersion Int
  status          BookingReminderStatus @default(PENDING)
  attempts        Int                   @default(0)
  nextAttemptAt   DateTime?
  lockedAt        DateTime?
  sentAt          DateTime?
  cancelledAt     DateTime?
  lastErrorCode   String?               @db.VarChar(100)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([bookingId, kind, scheduleVersion])
  @@index([status, nextAttemptAt, scheduledFor])
  @@index([bookingId, scheduleVersion])
}

model ServiceQuote {
  id               String      @id @default(uuid()) @db.Uuid
  bookingId        String      @db.Uuid
  createdByStaffId String      @db.Uuid
  quoteNumber      String      @unique @db.VarChar(40)
  version          Int         @default(1)
  revision         Int         @default(0)
  status           QuoteStatus @default(DRAFT)
  currency         String      @default("NGN") @db.Char(3)
  subtotalKobo     BigInt
