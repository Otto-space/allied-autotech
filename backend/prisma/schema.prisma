enum ManualPaymentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PENDING
  PROCESSING
  NEEDS_ATTENTION
  SUCCEEDED
  FAILED
  CANCELLED
}

enum DisputeStatus {
  AWAITING_RESPONSE
  UNDER_REVIEW
  WON
  LOST
  ACCEPTED
  EXPIRED
}

enum DisputeCategory {
  NOT_RECOGNIZED
