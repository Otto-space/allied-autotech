enum PaymentPurpose {
  ORDER_PAYMENT
  SERVICE_INVOICE
  BOOKING_DEPOSIT
  VEHICLE_RESERVATION
  VEHICLE_PARTIAL_PAYMENT
  VEHICLE_BALANCE_PAYMENT
  VEHICLE_FULL_PAYMENT
