generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================
// ENUMS
// =========================

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ServicePricingType {
  FIXED
  QUOTE_REQUIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

enum FulfillmentMethod {
  COLLECTION
  DELIVERY
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  ABANDONED
  REFUNDED
}

enum PaymentGateway {
  PAYSTACK
  MANUAL
}

enum VehicleListingStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  ARCHIVED
}

enum InspectionStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewTargetType {
  BUSINESS
  SERVICE
  ORDER
}

enum EnquiryType {
  GENERAL
  PRODUCT
  VEHICLE
  SERVICE
  BOOKING
  QUOTATION
}

enum EnquiryStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ComplaintStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum NotificationType {
  BOOKING
  ORDER
  PAYMENT
  INSPECTION
  ENQUIRY
  COMPLAINT
  REVIEW
  PROMOTION
  SYSTEM
}

enum Transmission {
  AUTOMATIC
  MANUAL
  CVT
  OTHER
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  OTHER
}

enum VehicleCondition {
  NEW
  USED
}

enum BodyType {
  SEDAN
  SUV
  COUPE
  HATCHBACK
  WAGON
  PICKUP
  VAN
  TRUCK
  BUS
  OTHER
}

enum DriveType {
  FWD
  RWD
  AWD
  FOUR_WD
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_RESET
  EMAIL_VERIFIED
  ROLE_CHANGE
  ACCOUNT_SUSPENDED
  ACCOUNT_DEACTIVATED
  SESSION_REVOKED
  STATUS_CHANGE
  INVENTORY_ADJUSTED
  PAYMENT_VERIFIED
  PAYMENT_REFUNDED
}

enum AuditEntityType {
  USER
  SESSION
  CUSTOMER_PROFILE
  STAFF_PROFILE
  CUSTOMER_VEHICLE
  SERVICE
  BOOKING
  PRODUCT
  INVENTORY
  ORDER
  PAYMENT
  VEHICLE_LISTING
  INSPECTION
  REVIEW
  ENQUIRY
  COMPLAINT
  PROMOTION
  INVOICE
}

enum InventoryTransactionType {
  STOCK_IN
  SALE
  RESERVATION
  RESERVATION_RELEASE
  RETURN
  ADJUSTMENT
  DAMAGE
  RESTOCK
}

// =========================
// IDENTITY / AUTH
// =========================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.Citext
  passwordHash String
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)

  emailVerifiedAt     DateTime?
  passwordChangedAt   DateTime?
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile                 CustomerProfile?
  staffProfile            StaffProfile?
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  auditLogs               AuditLog[]
  notifications           Notification[]

  @@index([role])
  @@index([status])
  @@index([lockedUntil])
}

model Session {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  tokenHash String @unique @db.VarChar(128)

  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?

  ipAddress String? @db.Inet
  userAgent String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model PasswordResetToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  tokenHash String @unique @db.VarChar(128)

  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  tokenHash String @unique @db.VarChar(128)

  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @db.Uuid

  action     AuditAction
  entityType AuditEntityType
  entityId   String?

  requestId String? @db.VarChar(100)

  oldValues Json?
  newValues Json?

  ipAddress String? @db.Inet
  userAgent String? @db.Text

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([requestId])
  @@index([createdAt])
}

// =========================
// PEOPLE
// =========================

model StaffProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  firstName String
  lastName  String
  phone     String? @db.VarChar(32)
  jobTitle  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedBookings    Booking[]           @relation("AssignedBookings")
  assignedEnquiries   Enquiry[]           @relation("AssignedEnquiries")
  assignedComplaints  Complaint[]         @relation("AssignedComplaints")
  assignedInspections InspectionRequest[] @relation("AssignedInspections")

  @@index([jobTitle])
}

model CustomerProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  firstName String
  lastName  String
  phone     String @db.VarChar(32)

  phoneVerifiedAt DateTime?

  address String?
  city    String?
  state   String?
  country String  @default("Nigeria")

  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerVehicles   CustomerVehicle[]
  bookings           Booking[]
  cart               Cart?
  orders             Order[]
  inspectionRequests InspectionRequest[]
  reviews            Review[]
  enquiries          Enquiry[]
  complaints         Complaint[]
  invoices           Invoice[]
  savedVehicles      SavedVehicle[]
  productFavourites  ProductFavourite[]

  @@index([phone])
  @@index([state])
}

model CustomerVehicle {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @db.Uuid

  make  String
  model String
  year  Int

  registrationNumber String?
  vin                String? @unique
  color              String?
  mileage            Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([customerId])
  @@index([registrationNumber])
  @@index([make, model])
}

// =========================
// SERVICES / BOOKINGS
// =========================

model Service {
  id   String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique

  description      String?
  shortDescription String?

  pricingType ServicePricingType @default(FIXED)
  price       Decimal?           @db.Decimal(12, 2)
  currency    String             @default("NGN") @db.VarChar(3)

  durationMinutes Int?
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings  Booking[]
  reviews   Review[]
  enquiries Enquiry[]

  @@index([isActive])
  @@index([pricingType, isActive])
}

model Booking {
  id              String  @id @default(uuid()) @db.Uuid
  customerId      String  @db.Uuid
  serviceId       String  @db.Uuid
  vehicleId       String? @db.Uuid
  assignedStaffId String? @db.Uuid

  scheduledAt DateTime
  status      BookingStatus @default(REQUESTED)

  quotedPrice Decimal? @db.Decimal(12, 2)
  currency    String   @default("NGN") @db.VarChar(3)

  customerNotes      String?
  staffNotes         String?
  cancellationReason String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  customer      CustomerProfile  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service       Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  vehicle       CustomerVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  assignedStaff StaffProfile?    @relation("AssignedBookings", fields: [assignedStaffId], references: [id], onDelete: SetNull)

  review     Review?
  invoice    Invoice?
  complaints Complaint[]

  @@index([serviceId])
  @@index([vehicleId])
  @@index([status, scheduledAt])
  @@index([assignedStaffId, status, scheduledAt])
  @@index([customerId, status])
  @@index([customerId, createdAt])
}

// =========================
// PRODUCT CATALOG / INVENTORY
// =========================

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  slug        String  @unique
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([isActive])
}

model Product {
  id         String @id @default(uuid()) @db.Uuid
  categoryId String @db.Uuid

  name String
  slug String @unique
  sku  String @unique

  brand                  String?
  manufacturerPartNumber String? @unique

  description String?
  price       Decimal @db.Decimal(12, 2)
  currency    String  @default("NGN") @db.VarChar(3)

  isActive Boolean @default(true)
  featured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category        Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images          ProductImage[]
  inventory       Inventory?
  orderItems      OrderItem[]
  cartItems       CartItem[]
  favouritedBy    ProductFavourite[]
  enquiries       Enquiry[]
  compatibilities ProductCompatibility[]

  @@index([categoryId, isActive])
  @@index([name])
  @@index([brand])
  @@index([featured, isActive])
}

model ProductCompatibility {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid

  make     String
  model    String?
  yearFrom Int?
  yearTo   Int?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([make, model])
}

model ProductImage {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid

  url       String
  altText   String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Inventory {
  id        String @id @default(uuid()) @db.Uuid
  productId String @unique @db.Uuid

  quantity     Int @default(0)
  reserved     Int @default(0)
  reorderLevel Int @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  transactions InventoryTransaction[]

  @@index([quantity])
}

model InventoryTransaction {
  id          String @id @default(uuid()) @db.Uuid
  inventoryId String @db.Uuid

  type     InventoryTransactionType
  quantity Int

  referenceType String?
  referenceId   String?
  note          String?

  createdAt DateTime @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  @@index([inventoryId, createdAt])
  @@index([type])
  @@index([referenceType, referenceId])
}

model ProductFavourite {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @db.Uuid
  productId  String @db.Uuid

  createdAt DateTime @default(now())

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([productId])
}

// =========================
// CART / ORDERS / PAYMENTS
// =========================

model Cart {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @unique @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]
}

model CartItem {
  id        String @id @default(uuid()) @db.Uuid
  cartId    String @db.Uuid
  productId String @db.Uuid

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@index([productId])
}

model Order {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @db.Uuid

  orderNumber String      @unique
  status      OrderStatus @default(PENDING)

  fulfillmentMethod FulfillmentMethod @default(COLLECTION)

  currency       String  @default("NGN") @db.VarChar(3)
  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  deliveryFee    Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)

  customerName  String
  customerEmail String @db.Citext
  customerPhone String @db.VarChar(32)

  deliveryName    String?
  deliveryPhone   String? @db.VarChar(32)
  deliveryAddress String?
  deliveryCity    String?
  deliveryState   String?
  deliveryCountry String?

  cancellationReason String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  paymentDueAt DateTime?
  paidAt       DateTime?
  processingAt DateTime?
  readyAt      DateTime?
  cancelledAt  DateTime?
  completedAt  DateTime?

  customer       CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  payments       Payment[]
  invoice        Invoice?
  promotionUsage PromotionUsage?
  review         Review?
  complaints     Complaint[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id        String @id @default(uuid()) @db.Uuid
  orderId   String @db.Uuid
  productId String @db.Uuid

  productName String
  sku         String

  unitPrice Decimal @db.Decimal(12, 2)
  quantity  Int
  subtotal  Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid

  reference            String  @unique @db.VarChar(120)
  gatewayTransactionId String? @unique @db.VarChar(120)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("NGN") @db.VarChar(3)

  status  PaymentStatus  @default(PENDING)
  gateway PaymentGateway @default(PAYSTACK)

  verifiedAt DateTime?
  paidAt     DateTime?

  failureReason   String?
  gatewayResponse Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order         Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  webhookEvents PaymentWebhookEvent[]

  @@index([orderId, status])
  @@index([status])
  @@index([createdAt])
}

model PaymentWebhookEvent {
  id        String  @id @default(uuid()) @db.Uuid
  paymentId String? @db.Uuid

  // Generate a stable idempotency key from the trusted gateway payload.
  eventId   String @unique @db.VarChar(160)
  eventType String @db.VarChar(120)

  payload Json

  processedAt     DateTime?
  failedAt        DateTime?
  processingError String?

  createdAt DateTime @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([eventType])
  @@index([createdAt])
}

// =========================
// VEHICLE MARKETPLACE
// =========================

model VehicleListing {
  id String @id @default(uuid()) @db.Uuid

  title String
  slug  String @unique

  make  String
  model String
  year  Int

  mileage  Int?
  price    Decimal @db.Decimal(14, 2)
  currency String  @default("NGN") @db.VarChar(3)

  transmission Transmission?
  fuelType     FuelType?
  condition    VehicleCondition @default(USED)
  bodyType     BodyType?

  engineSize String?
  driveType  DriveType?

  color String?
  doors Int?
  seats Int?

  description String?

  status   VehicleListingStatus @default(DRAFT)
  featured Boolean              @default(false)

  registrationNumber String?
  vin                String? @unique

  publishedAt DateTime?
  soldAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images           VehicleImage[]
  inspections      InspectionRequest[]
  enquiries        Enquiry[]
  savedByCustomers SavedVehicle[]

  @@index([status, make, model])
  @@index([status, year])
  @@index([status, price])
  @@index([featured, status])
}

model VehicleImage {
  id        String @id @default(uuid()) @db.Uuid
  vehicleId String @db.Uuid

  url       String
  altText   String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  vehicle VehicleListing @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, sortOrder])
}

model InspectionRequest {
  id              String  @id @default(uuid()) @db.Uuid
  customerId      String  @db.Uuid
  vehicleId       String  @db.Uuid
  assignedStaffId String? @db.Uuid

  requestedAt DateTime
  scheduledAt DateTime?

  status InspectionStatus @default(REQUESTED)

  notes              String?
  cancellationReason String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  customer      CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle       VehicleListing  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  assignedStaff StaffProfile?   @relation("AssignedInspections", fields: [assignedStaffId], references: [id], onDelete: SetNull)

  @@index([customerId, requestedAt])
  @@index([vehicleId])
  @@index([status, requestedAt])
  @@index([assignedStaffId, status])
}

model SavedVehicle {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @db.Uuid
  vehicleId  String @db.Uuid

  createdAt DateTime @default(now())

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle  VehicleListing  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([customerId, vehicleId])
  @@index([vehicleId])
}

// =========================
// REVIEWS / CUSTOMER CARE
// =========================

model Review {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @db.Uuid

  targetType ReviewTargetType

  serviceId String? @db.Uuid
  bookingId String? @unique @db.Uuid
  orderId   String? @unique @db.Uuid

  rating  Int
  title   String?
  comment String

  status ReviewStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service  Service?        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  booking  Booking?        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  order    Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([serviceId])
  @@index([status, createdAt])
}

model Enquiry {
  id              String  @id @default(uuid()) @db.Uuid
  customerId      String? @db.Uuid
  productId       String? @db.Uuid
  serviceId       String? @db.Uuid
  vehicleId       String? @db.Uuid
  assignedStaffId String? @db.Uuid

  type    EnquiryType
  status  EnquiryStatus @default(OPEN)
  subject String
  message String

  name  String
  email String  @db.Citext
  phone String? @db.VarChar(32)

  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer      CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product       Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  service       Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  vehicle       VehicleListing?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  assignedStaff StaffProfile?    @relation("AssignedEnquiries", fields: [assignedStaffId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([vehicleId])
  @@index([type, status])
  @@index([status, createdAt])
  @@index([assignedStaffId, status])
}

model Complaint {
  id              String  @id @default(uuid()) @db.Uuid
  customerId      String? @db.Uuid
  bookingId       String? @db.Uuid
  orderId         String? @db.Uuid
  assignedStaffId String? @db.Uuid

  priority ComplaintPriority @default(MEDIUM)
  status   ComplaintStatus   @default(OPEN)

  name  String?
  email String? @db.Citext
  phone String? @db.VarChar(32)

  subject     String
  description String
  resolution  String?

  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer      CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  booking       Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  order         Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  assignedStaff StaffProfile?    @relation("AssignedComplaints", fields: [assignedStaffId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([bookingId])
  @@index([orderId])
  @@index([status, priority, createdAt])
  @@index([assignedStaffId, status])
}

// =========================
// PROMOTIONS / INVOICES / NOTIFICATIONS
// =========================

model Promotion {
  id String @id @default(uuid()) @db.Uuid

  name String
  code String? @unique @db.Citext

  description String?

  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)

  minimumOrderAmount    Decimal? @db.Decimal(12, 2)
  maximumDiscountAmount Decimal? @db.Decimal(12, 2)

  usageLimit       Int?
  perCustomerLimit Int?

  startsAt DateTime
  endsAt   DateTime

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  promotionUsages PromotionUsage[]

  @@index([isActive, startsAt, endsAt])
}

model PromotionUsage {
  id          String @id @default(uuid()) @db.Uuid
  promotionId String @db.Uuid
  orderId     String @unique @db.Uuid

  promotionCodeSnapshot String?      @db.Citext
  discountTypeSnapshot  DiscountType
  discountValueSnapshot Decimal      @db.Decimal(12, 2)
  discountAmount        Decimal      @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([promotionId])
}

model Invoice {
  id String @id @default(uuid()) @db.Uuid

  invoiceNumber String @unique

  customerId String  @db.Uuid
  orderId    String? @unique @db.Uuid
  bookingId  String? @unique @db.Uuid

  currency String  @default("NGN") @db.VarChar(3)
  subtotal Decimal @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  status InvoiceStatus @default(DRAFT)

  issuedAt DateTime?
  dueAt    DateTime?
  paidAt   DateTime?
  voidedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order    Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  booking  Booking?        @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([status])
}

model Notification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  type    NotificationType
  title   String
  message String

  readAt    DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([expiresAt])
}
