// A Payment is a server-created request for an exact amount and payable target.
// Gateway/manual retries are PaymentAttempt rows. Only a verified attempt may be
// selected as settledAttempt; duplicate successful charges remain recordable.
model Payment {
  id                   String              @id @default(uuid()) @db.Uuid
  customerId           String?             @db.Uuid
  orderId              String?             @db.Uuid
  invoiceId            String?             @db.Uuid
  vehicleTransactionId String?             @db.Uuid
  bookingId            String?             @unique @db.Uuid
  paymentNumber        String              @unique @db.VarChar(50)
  purpose              PaymentPurpose
  amountKobo           BigInt
  currency             String              @default("NGN") @db.Char(3)
  status               PaymentIntentStatus @default(REQUIRES_PAYMENT)
  idempotencyKeyHash   String              @unique @db.Char(64)
  settledAttemptId     String?             @unique @db.Uuid
  description          String?
  expiresAt            DateTime?
  succeededAt          DateTime?
  cancelledAt          DateTime?
  expiredAt            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  customer           CustomerProfile?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order              Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  invoice            Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  vehicleTransaction VehicleTransaction? @relation(fields: [vehicleTransactionId], references: [id], onDelete: Restrict)
  booking            Booking?            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  settledAttempt     PaymentAttempt?     @relation("SettledAttempt", fields: [settledAttemptId], references: [id], onDelete: Restrict)
  attempts           PaymentAttempt[]    @relation("PaymentAttempts")
  anomalies          PaymentAnomaly[]

  @@index([customerId, createdAt])
  @@index([orderId, status])
  @@index([invoiceId, status])
  @@index([vehicleTransactionId, status])
  @@index([bookingId, status])
  @@index([status, createdAt])
}

model PaymentAttempt {
  id                     String                    @id @default(uuid()) @db.Uuid
  paymentId              String                    @db.Uuid
  attemptNumber          Int
  internalReference      String                    @unique @db.VarChar(120)
  provider               PaymentProvider
  method                 PaymentMethod?
  status                 PaymentAttemptStatus      @default(INITIALIZED)
  verificationStatus     PaymentVerificationStatus @default(UNVERIFIED)
  amountKobo             BigInt
  currency               String                    @default("NGN") @db.Char(3)
  verifiedAmountKobo     BigInt?
  verifiedCurrency       String?                   @db.Char(3)
  providerReference      String?                   @db.VarChar(160)
  gatewayTransactionId   String?                   @db.VarChar(160)
  providerFeeKobo        BigInt?
  gatewayStatus          String?                   @db.VarChar(80)
  failureCode            String?                   @db.VarChar(100)
  failureMessage         String?
  redactedGatewayData    Json?
  encryptedCheckoutState Json?
  authorizationExpiresAt DateTime?
  initiatedAt            DateTime                  @default(now())
  paidAt                 DateTime?
  verifiedAt             DateTime?
  failedAt               DateTime?
  abandonedAt            DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  payment             Payment                     @relation("PaymentAttempts", fields: [paymentId], references: [id], onDelete: Restrict)
  settlesPayment      Payment?                    @relation("SettledAttempt")
  manualReview        ManualPaymentReview?
  refunds             Refund[]
  disputes            PaymentDispute[]
  webhookEvents       PaymentWebhookEvent[]
  anomalies           PaymentAnomaly[]
  ledgerEntries       PaymentLedgerEntry[]
  reconciliationItems PaymentReconciliationItem[]

  @@unique([paymentId, attemptNumber])
  @@unique([provider, providerReference])
  @@index([paymentId, status])
  @@index([provider, gatewayTransactionId])
  @@index([provider, status, initiatedAt])
  @@index([status, createdAt])
}

model ManualPaymentReview {
  id                String                    @id @default(uuid()) @db.Uuid
  paymentAttemptId  String                    @unique @db.Uuid
  submittedByUserId String?                   @db.Uuid
  reviewedByUserId  String?                   @db.Uuid
  status            ManualPaymentReviewStatus @default(PENDING)
  bankReference     String?                   @db.VarChar(160)
  payerName         String?
  transferredAt     DateTime?
  evidenceObjectKey String?
  evidenceSha256    String?                   @db.Char(64)
  reviewerNote      String?
  submittedAt       DateTime                  @default(now())
  reviewedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  submittedBy    User?          @relation("ManualPaymentSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reviewedBy     User?          @relation("ManualPaymentReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([status, submittedAt])
  @@index([reviewedByUserId])
}

model Refund {
  id                 String       @id @default(uuid()) @db.Uuid
  paymentAttemptId   String       @db.Uuid
  requestedByUserId  String       @db.Uuid
  approvedByUserId   String?      @db.Uuid
  refundNumber       String       @unique @db.VarChar(50)
  idempotencyKeyHash String       @unique @db.Char(64)
  providerRefundId   String?      @unique @db.VarChar(160)
  amountKobo         BigInt
  currency           String       @default("NGN") @db.Char(3)
  status             RefundStatus @default(REQUESTED)
  reason             String
  providerStatus     String?      @db.VarChar(80)
  failureCode        String?      @db.VarChar(100)
  failureMessage     String?
  requestedAt        DateTime     @default(now())
  approvedAt         DateTime?
  processedAt        DateTime?
  failedAt           DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  paymentAttempt      PaymentAttempt              @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  requestedBy         User                        @relation("RefundRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  approvedBy          User?                       @relation("RefundApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  webhookEvents       PaymentWebhookEvent[]
  ledgerEntries       PaymentLedgerEntry[]
  anomalies           PaymentAnomaly[]
  reconciliationItems PaymentReconciliationItem[]

  @@index([paymentAttemptId, status])
  @@index([status, createdAt])
  @@index([approvedByUserId])
}

model PaymentDispute {
  id                String          @id @default(uuid()) @db.Uuid
  paymentAttemptId  String          @db.Uuid
  provider          PaymentProvider
  providerDisputeId String          @db.VarChar(160)
  status            DisputeStatus
  category          DisputeCategory
  amountKobo        BigInt
  currency          String          @default("NGN") @db.Char(3)
  reason            String?
  responseDueAt     DateTime?
  evidenceObjectKey String?
  evidenceSha256    String?         @db.Char(64)
  openedAt          DateTime
  respondedAt       DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  paymentAttempt      PaymentAttempt              @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  webhookEvents       PaymentWebhookEvent[]
  ledgerEntries       PaymentLedgerEntry[]
  anomalies           PaymentAnomaly[]
  reconciliationItems PaymentReconciliationItem[]

  @@unique([provider, providerDisputeId])
  @@index([paymentAttemptId])
  @@index([status, responseDueAt])
}

model PaymentWebhookEvent {
  id                  String                  @id @default(uuid()) @db.Uuid
  paymentAttemptId    String?                 @db.Uuid
  refundId            String?                 @db.Uuid
  disputeId           String?                 @db.Uuid
  provider            PaymentProvider
  providerEventId     String?                 @db.VarChar(180)
  deduplicationKey    String                  @db.Char(64)
  eventType           String                  @db.VarChar(120)
  payloadSha256       String                  @db.Char(64)
  redactedPayload     Json?
  signatureVerifiedAt DateTime?
  providerVerifiedAt  DateTime?
  status              WebhookProcessingStatus @default(RECEIVED)
  processingAttempts  Int                     @default(0)
  nextAttemptAt       DateTime?
  lockedAt            DateTime?
  processedAt         DateTime?
  failedAt            DateTime?
  lastErrorCode       String?                 @db.VarChar(100)
  lastErrorMessage    String?
  receivedAt          DateTime                @default(now())
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  refund         Refund?         @relation(fields: [refundId], references: [id], onDelete: SetNull)
  dispute        PaymentDispute? @relation(fields: [disputeId], references: [id], onDelete: SetNull)

  @@unique([provider, deduplicationKey])
  @@unique([provider, providerEventId])
  @@index([status, nextAttemptAt, receivedAt])
  @@index([paymentAttemptId])
  @@index([refundId])
  @@index([disputeId])
  @@index([eventType, receivedAt])
}

model PaymentAnomaly {
  id               String               @id @default(uuid()) @db.Uuid
  paymentId        String?              @db.Uuid
  paymentAttemptId String?              @db.Uuid
  refundId         String?              @db.Uuid
  disputeId        String?              @db.Uuid
  resolvedByUserId String?              @db.Uuid
  type             PaymentAnomalyType
  status           PaymentAnomalyStatus @default(OPEN)
  summary          String
  details          Json?
  detectedAt       DateTime             @default(now())
  resolvedAt       DateTime?
  resolutionNote   String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  payment        Payment?        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  refund         Refund?         @relation(fields: [refundId], references: [id], onDelete: Restrict)
  dispute        PaymentDispute? @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  resolvedBy     User?           @relation("AnomalyResolver", fields: [resolvedByUserId], references: [id], onDelete: Restrict)

  @@index([status, detectedAt])
  @@index([paymentId])
  @@index([paymentAttemptId])
}

model PaymentLedgerEntry {
