  priceHistory     VehiclePriceHistory[]
  inspections      InspectionRequest[]
  enquiries        Enquiry[]
  savedByCustomers SavedVehicle[]
  transactions     VehicleTransaction[]

  @@index([branchId, status])
  @@index([vehicleId])
  @@index([status, priceKobo])
  @@index([featured, status])
  @@index([createdAt])
}

model VehicleImage {
  id             String   @id @default(uuid()) @db.Uuid
  vehicleId      String   @db.Uuid
  url            String
  publicId       String?  @unique
  altText        String?
  sortOrder      Int      @default(0)
  isPrimary      Boolean  @default(false)
  checksumSha256 String?  @db.Char(64)
  createdAt      DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, sortOrder])
}

model VehiclePriceHistory {
  id               String   @id @default(uuid()) @db.Uuid
  vehicleListingId String   @db.Uuid
  changedByStaffId String   @db.Uuid
  oldPriceKobo     BigInt
  newPriceKobo     BigInt
  currency         String   @default("NGN") @db.Char(3)
  reason           String?
  createdAt        DateTime @default(now())

  listing        VehicleListing @relation(fields: [vehicleListingId], references: [id], onDelete: Restrict)
  changedByStaff StaffProfile   @relation(fields: [changedByStaffId], references: [id], onDelete: Restrict)

  @@index([vehicleListingId, createdAt])
}

model VehicleDocument {
  id                 String                     @id @default(uuid()) @db.Uuid
  vehicleId          String                     @db.Uuid
  reviewedByStaffId  String?                    @db.Uuid
  type               VehicleDocumentType
  verificationStatus DocumentVerificationStatus @default(PENDING)
  objectKey          String                     @unique
  checksumSha256     String                     @db.Char(64)
  mimeType           String                     @db.VarChar(100)
  sizeBytes          BigInt
  issuedAt           DateTime?
  expiresAt          DateTime?
  verifiedAt         DateTime?
  rejectionReason    String?
  version            Int                        @default(0)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  vehicle    Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  reviewedBy StaffProfile? @relation(fields: [reviewedByStaffId], references: [id], onDelete: Restrict)

  @@index([vehicleId, type])
  @@index([verificationStatus])
  @@index([vehicleId, verificationStatus, createdAt(sort: Desc)], map: "VehicleDocument_vehicle_status_idx")
}

model VehicleConditionReport {
  id              String   @id @default(uuid()) @db.Uuid
  vehicleId       String   @db.Uuid
  inspectionId    String?  @unique @db.Uuid
  odometerKm      Int?
  conditionScore  Int?
  summary         String
  findings        Json?
  reportObjectKey String?
  reportSha256    String?  @db.Char(64)
  inspectedAt     DateTime
  createdAt       DateTime @default(now())

  vehicle    Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  inspection InspectionRequest? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  @@index([vehicleId, inspectedAt])
}

model InspectionRequest {
  id                 String           @id @default(uuid()) @db.Uuid
  customerId         String?          @db.Uuid
  vehicleListingId   String           @db.Uuid
  assignedStaffId    String?          @db.Uuid
  customerName       String
  customerPhone      String           @db.VarChar(32)
  customerEmail      String?          @db.Citext
  preferredStartAt   DateTime
  preferredEndAt     DateTime?
  scheduledStartAt   DateTime?
  scheduledEndAt     DateTime?
  status             InspectionStatus @default(REQUESTED)
  notes              String?
  cancellationReason String?
  version            Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  confirmedAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?

  customer             CustomerProfile?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicleListing       VehicleListing          @relation(fields: [vehicleListingId], references: [id], onDelete: Restrict)
  assignedStaff        StaffProfile?           @relation("AssignedInspections", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  convertedTransaction VehicleTransaction?
  conditionReport      VehicleConditionReport?

  @@index([customerId, preferredStartAt])
  @@index([vehicleListingId, status])
  @@index([status, preferredStartAt])
  @@index([assignedStaffId, status])
}

model VehicleTransaction {
  id                      String                   @id @default(uuid()) @db.Uuid
  vehicleListingId        String                   @db.Uuid
  customerId              String?                  @db.Uuid
  sourceEnquiryId         String?                  @unique @db.Uuid
  sourceInspectionId      String?                  @unique @db.Uuid
  transactionNumber       String                   @unique @db.VarChar(50)
  customerName            String
  customerPhone           String                   @db.VarChar(32)
  customerEmail           String?                  @db.Citext
  askingPriceKobo         BigInt
  agreedPriceKobo         BigInt?
  reservationRequiredKobo BigInt?
  currency                String                   @default("NGN") @db.Char(3)
  status                  VehicleTransactionStatus @default(ENQUIRY)
  reservationExpiresAt    DateTime?
  termsVersion            String?                  @db.VarChar(40)
  termsAcceptedAt         DateTime?
  notes                   String?
  cancellationReason      String?
  version                 Int                      @default(0)
  paidAt                  DateTime?
  handoverPendingAt       DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  expiredAt               DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  vehicleListing   VehicleListing                    @relation(fields: [vehicleListingId], references: [id], onDelete: Restrict)
  customer         CustomerProfile?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sourceEnquiry    Enquiry?                          @relation(fields: [sourceEnquiryId], references: [id], onDelete: SetNull)
  sourceInspection InspectionRequest?                @relation(fields: [sourceInspectionId], references: [id], onDelete: SetNull)
  payments         Payment[]
  statusHistory    VehicleTransactionStatusHistory[]
  invoice          Invoice?
  handover         VehicleHandover?
  review           Review?
  complaints       Complaint[]

  @@index([vehicleListingId, status])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([reservationExpiresAt])
}

model VehicleTransactionStatusHistory {
  id                   String                    @id @default(uuid()) @db.Uuid
  vehicleTransactionId String                    @db.Uuid
  changedByUserId      String?                   @db.Uuid
  fromStatus           VehicleTransactionStatus?
  toStatus             VehicleTransactionStatus
  reason               String?
  createdAt            DateTime                  @default(now())

  vehicleTransaction VehicleTransaction @relation(fields: [vehicleTransactionId], references: [id], onDelete: Restrict)
  changedBy          User?              @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([vehicleTransactionId, createdAt])
  @@index([changedByUserId])
}

model VehicleHandover {
  id                      String                @id @default(uuid()) @db.Uuid
  vehicleTransactionId    String                @unique @db.Uuid
  handledByStaffId        String                @db.Uuid
  status                  VehicleHandoverStatus @default(PENDING)
  recipientName           String?
  recipientPhone          String?               @db.VarChar(32)
  odometerKm              Int?
  keysDelivered           Int                   @default(0)
  signedDocumentObjectKey String?
  signedDocumentSha256    String?               @db.Char(64)
  readyAt                 DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  version                 Int                   @default(0)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  vehicleTransaction VehicleTransaction @relation(fields: [vehicleTransactionId], references: [id], onDelete: Restrict)
  handledByStaff     StaffProfile       @relation(fields: [handledByStaffId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
}

model SavedVehicle {
  id               String   @id @default(uuid()) @db.Uuid
  customerId       String   @db.Uuid
  vehicleListingId String   @db.Uuid
  createdAt        DateTime @default(now())

  customer       CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleListing VehicleListing  @relation(fields: [vehicleListingId], references: [id], onDelete: Cascade)

  @@unique([customerId, vehicleListingId])
  @@index([vehicleListingId])
}

model Review {
  id                   String           @id @default(uuid()) @db.Uuid
  customerId           String           @db.Uuid
  targetType           ReviewTargetType
  productId            String?          @db.Uuid
  orderItemId          String?          @unique @db.Uuid
  serviceId            String?          @db.Uuid
  bookingId            String?          @unique @db.Uuid
  orderId              String?          @unique @db.Uuid
  vehicleTransactionId String?          @unique @db.Uuid
  rating               Int
  title                String?
  comment              String
  status               ReviewStatus     @default(PENDING)
  moderatedByUserId    String?          @db.Uuid
  moderationNote       String?
  moderatedAt          DateTime?
  version              Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  customer           CustomerProfile     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product            Product?            @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItem          OrderItem?          @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  service            Service?            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  booking            Booking?            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  order              Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vehicleTransaction VehicleTransaction? @relation(fields: [vehicleTransactionId], references: [id], onDelete: Restrict)
  moderatedBy        User?               @relation("ReviewModerator", fields: [moderatedByUserId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([productId])
  @@index([serviceId])
  @@index([status, createdAt])
  @@index([moderatedByUserId])
}

model Enquiry {
  id               String        @id @default(uuid()) @db.Uuid
  customerId       String?       @db.Uuid
  branchId         String?       @db.Uuid
  productId        String?       @db.Uuid
  serviceId        String?       @db.Uuid
  bookingId        String?       @db.Uuid
  quoteId          String?       @db.Uuid
  vehicleListingId String?       @db.Uuid
  assignedStaffId  String?       @db.Uuid
  type             EnquiryType
  status           EnquiryStatus @default(OPEN)
  subject          String
  message          String
  name             String
  email            String        @db.Citext
  phone            String?       @db.VarChar(32)
  resolvedAt       DateTime?
  closedAt         DateTime?
  version          Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  customer             CustomerProfile?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  branch               Branch?             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product              Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  service              Service?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  booking              Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  quote                ServiceQuote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  vehicleListing       VehicleListing?     @relation(fields: [vehicleListingId], references: [id], onDelete: SetNull)
  assignedStaff        StaffProfile?       @relation("AssignedEnquiries", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  convertedTransaction VehicleTransaction?
  messages             SupportMessage[]

  @@index([customerId])
  @@index([branchId, status, createdAt])
  @@index([vehicleListingId])
  @@index([bookingId])
  @@index([quoteId])
  @@index([type, status])
  @@index([status, createdAt])
  @@index([assignedStaffId, status])
}

model Complaint {
  id                   String            @id @default(uuid()) @db.Uuid
  customerId           String?           @db.Uuid
  branchId             String?           @db.Uuid
  bookingId            String?           @db.Uuid
  orderId              String?           @db.Uuid
  vehicleTransactionId String?           @db.Uuid
  assignedStaffId      String?           @db.Uuid
  priority             ComplaintPriority @default(MEDIUM)
  status               ComplaintStatus   @default(OPEN)
  name                 String?
  email                String?           @db.Citext
  phone                String?           @db.VarChar(32)
  subject              String
  description          String
  resolution           String?
  resolvedAt           DateTime?
  closedAt             DateTime?
  version              Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  customer           CustomerProfile?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  branch             Branch?             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  booking            Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  order              Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  vehicleTransaction VehicleTransaction? @relation(fields: [vehicleTransactionId], references: [id], onDelete: SetNull)
  assignedStaff      StaffProfile?       @relation("AssignedComplaints", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  messages           SupportMessage[]

  @@index([customerId])
  @@index([branchId, status, priority, createdAt])
  @@index([bookingId])
  @@index([orderId])
  @@index([vehicleTransactionId])
  @@index([status, priority, createdAt])
  @@index([assignedStaffId, status])
}

model SupportMessage {
  id           String                   @id @default(uuid()) @db.Uuid
  enquiryId    String?                  @db.Uuid
  complaintId  String?                  @db.Uuid
  authorUserId String?                  @db.Uuid
  authorType   SupportMessageAuthorType
  visibility   SupportMessageVisibility @default(CUSTOMER)
  body         String
  createdAt    DateTime                 @default(now())

  enquiry   Enquiry?   @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  complaint Complaint? @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  author    User?      @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([enquiryId, createdAt])
  @@index([complaintId, createdAt])
  @@index([authorUserId])
}

model Promotion {
  id                        String       @id @default(uuid()) @db.Uuid
  name                      String
  code                      String?      @unique @db.Citext
  description               String?
  discountType              DiscountType
  percentageBasisPoints     Int?
  fixedAmountKobo           BigInt?
  minimumOrderAmountKobo    BigInt?
  maximumDiscountAmountKobo BigInt?
  usageLimit                Int?
  perCustomerLimit          Int?
  startsAt                  DateTime
  endsAt                    DateTime
  isActive                  Boolean      @default(true)
  version                   Int          @default(0)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  promotionUsages PromotionUsage[]

  @@index([isActive, startsAt, endsAt])
}

model PromotionUsage {
  id                            String       @id @default(uuid()) @db.Uuid
  promotionId                   String       @db.Uuid
  orderId                       String       @unique @db.Uuid
  promotionCodeSnapshot         String?      @db.Citext
  discountTypeSnapshot          DiscountType
  percentageBasisPointsSnapshot Int?
  fixedAmountKoboSnapshot       BigInt?
  discountAmountKobo            BigInt
  createdAt                     DateTime     @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([promotionId])
  @@index([promotionId, createdAt])
}

model Invoice {
  id                   String        @id @default(uuid()) @db.Uuid
  invoiceNumber        String        @unique @db.VarChar(50)
  customerId           String        @db.Uuid
  orderId              String?       @unique @db.Uuid
  bookingId            String?       @unique @db.Uuid
  vehicleTransactionId String?       @unique @db.Uuid
  currency             String        @default("NGN") @db.Char(3)
  subtotalKobo         BigInt
  taxKobo              BigInt        @default(0)
  depositCreditKobo    BigInt        @default(0)
  totalKobo            BigInt
  status               InvoiceStatus @default(DRAFT)
  version              Int           @default(0)
  issuedAt             DateTime?
  dueAt                DateTime?
  paidAt               DateTime?
  voidedAt             DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  customer           CustomerProfile     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order              Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  booking            Booking?            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  vehicleTransaction VehicleTransaction? @relation(fields: [vehicleTransactionId], references: [id], onDelete: Restrict)
  payments           Payment[]

  @@index([customerId, createdAt])
  @@index([status])
}

model Notification {
  id               String               @id @default(uuid()) @db.Uuid
  userId           String               @db.Uuid
  type             NotificationType
  category         NotificationCategory @default(TRANSACTIONAL)
  title            String
  message          String
  resourceType     String?              @db.VarChar(80)
  resourceId       String?              @db.VarChar(120)
  deduplicationKey String?              @unique @db.VarChar(160)
  readAt           DateTime?
  expiresAt        DateTime?
  createdAt        DateTime             @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, readAt, createdAt])
  @@index([expiresAt])
  @@index([userId, category, createdAt])
}

model NotificationPreference {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @db.Uuid
  category    NotificationCategory
  channel     NotificationChannel
  enabled     Boolean              @default(true)
  consentedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, channel])
  @@index([userId])
}

model NotificationDelivery {
  id             String              @id @default(uuid()) @db.Uuid
  notificationId String              @db.Uuid
  outboxEventId  String?             @unique @db.Uuid
  channel        NotificationChannel
  status         OutboxStatus        @default(PENDING)
  attempts       Int                 @default(0)
  lastErrorCode  String?             @db.VarChar(100)
  deliveredAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  outboxEvent  OutboxEvent? @relation(fields: [outboxEventId], references: [id], onDelete: SetNull)

  @@unique([notificationId, channel])
  @@index([status, createdAt])
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String?           @db.Uuid
  scope          String            @db.VarChar(100)
  keyHash        String            @db.Char(64)
  requestHash    String            @db.Char(64)
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?
  responseBody   Json?
  lockedAt       DateTime?
  completedAt    DateTime?
  expiresAt      DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([scope, keyHash])
  @@index([status, expiresAt])
  @@index([userId, createdAt])
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  eventId       String       @unique @db.Uuid
  aggregateType String       @db.VarChar(100)
  aggregateId   String       @db.VarChar(120)
  eventType     String       @db.VarChar(120)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  lockedAt      DateTime?
  publishedAt   DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  notificationDelivery NotificationDelivery?

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
}
