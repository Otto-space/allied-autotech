generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Allied AutoTech hardened Phase 2.1 schema.
// Monetary values are integer minor units (kobo), never floating point.
// Custom CHECK constraints, partial indexes, immutability guards, and payment
// settlement/refund triggers are in secure-payment-and-domain-constraints.sql.

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum MfaFactorType {
  TOTP
  WEBAUTHN
}

enum MfaFactorStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum MfaChallengePurpose {
  REGISTRATION
  AUTHENTICATION
}

enum BookingStatus {
  REQUESTED
  AWAITING_DEPOSIT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  EXPIRED
}

enum BookingSlotStatus {
  OPEN
  CLOSED
}

enum BookingReminderKind {
  SEVEN_DAYS
  THREE_DAYS
  TWO_DAYS
  ONE_DAY
}

enum BookingReminderStatus {
  PENDING
  PROCESSING
  SENT
  CANCELLED
  FAILED
  DEAD_LETTER
}

enum BookingDisruptionResolution {
  PENDING
  TRANSFERRED
  REFUND_REQUESTED
}

enum ServicePricingType {
  FIXED
  QUOTE_REQUIRED
}

enum QuoteStatus {
  DRAFT
  ISSUED
  ACCEPTED
  REJECTED
  EXPIRED
  VOID
}

enum WorkOrderStatus {
  DRAFT
  APPROVED
  IN_PROGRESS
  AWAITING_PARTS
  QUALITY_CHECK
  COMPLETED
  CANCELLED
}

enum LineItemType {
  LABOUR
  PART
  FEE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

enum FulfillmentMethod {
  COLLECTION
  DELIVERY
}

enum PaymentIntentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  REQUIRES_REVIEW
  SUCCEEDED
  CANCELLED
  EXPIRED
}

enum PaymentAttemptStatus {
  INITIALIZED
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  ABANDONED
  CANCELLED
}

enum PaymentVerificationStatus {
  UNVERIFIED
  VERIFIED
  MISMATCH
  MANUAL_REVIEW
