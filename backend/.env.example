# Runtime mode and HTTP server
NODE_ENV=development
SERVICE_NAME=allied-autotech-api
PORT=5000
FRONTEND_URL=http://localhost:3000
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
REQUEST_BODY_LIMIT=100kb
READINESS_TIMEOUT_MS=2000
GLOBAL_RATE_LIMIT=300
GLOBAL_RATE_WINDOW_MS=900000
API_DOCS_ENABLED=true

# PostgreSQL connection; replace every value outside local development.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=allied_autotech
DB_USER=postgres
DB_PASSWORD=replace-with-a-local-development-password
# Use verify-full plus an absolute CA path in staging and production.
DB_SSL_MODE=disable
DB_SSL_CA_FILE=
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000

# Generate each key independently with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_HASH_KEY=replace-with-a-base64-encoded-256-bit-key
TOKEN_HASH_KEY_ID=identity-tokens-v1
MFA_ENCRYPTION_KEY=replace-with-a-different-base64-encoded-256-bit-key
MFA_ENCRYPTION_KEY_ID=identity-mfa-v1
OUTBOX_ENCRYPTION_KEY=replace-with-another-base64-encoded-256-bit-key
OUTBOX_ENCRYPTION_KEY_ID=identity-outbox-v1

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Allied AutoTech
WEBAUTHN_ORIGINS=http://localhost:3000

# Required in production. Keep provider credentials out of committed files.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@example.com
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/payments/complete
PAYSTACK_REQUEST_TIMEOUT_MS=8000
PAYSTACK_MAX_RESPONSE_BYTES=262144
PAYMENT_INTENT_TTL_SECONDS=1800
FRONTEND_VERIFY_EMAIL_URL=http://localhost:3000/verify-email
FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password
FRONTEND_PRIVILEGED_INVITATION_URL=http://localhost:3000/staff/accept-invitation
PRIVILEGED_INVITATION_TTL_SECONDS=86400

# S3-compatible private object storage. Required in production.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=allied-autotech-private
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
ASSET_TICKET_KEY=replace-with-a-fourth-base64-encoded-256-bit-key
ASSET_TICKET_KEY_ID=vehicle-assets-v1
ASSET_UPLOAD_TTL_SECONDS=300
ASSET_DOWNLOAD_TTL_SECONDS=120

# Test-only migration replay requires a newly created empty _test or _ci database.
# CONFIRM_EMPTY_MIGRATION_DATABASE=true
# TEST_DB_NAME=allied_autotech_test
# RUN_DATABASE_TESTS=true
