# Placeholders only; do not deploy unchanged. See docs/owner-staging-runbook.md.
# Component-specific variables are listed in docs/runtime-processes.md.
# Comma-separated exact origins/allowlists; booleans are lowercase true/false.
# TRUST_PROXY_CIDRS stays empty until actual ingress topology is verified. Never use 0.0.0.0/0 or ::/0.
# Email/SMS disabled: no fake delivery/verification; enable only with verified provider and allowlists.
NODE_ENV=production
DEPLOYMENT_ENV=staging
SERVICE_NAME=allied-autotech-api
PORT=5000
FRONTEND_URL=https://staging.alliedautotech.com
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
REQUEST_BODY_LIMIT=100kb
READINESS_TIMEOUT_MS=2000
GLOBAL_RATE_LIMIT=300
GLOBAL_RATE_WINDOW_MS=60000
API_DOCS_ENABLED=false
DB_HOST=REPLACE_MANAGED_POSTGRES_HOST
DB_PORT=25060
DB_NAME=allied_autotech_staging
DB_USER=REPLACE_STAGING_RUNTIME_ROLE
DB_PASSWORD=REPLACE_STAGING_RUNTIME_PASSWORD
DB_SSL_MODE=verify-full
DB_SSL_CA_FILE=/tmp/allied-autotech-secrets/database-ca.pem
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000
TOKEN_HASH_KEY=REPLACE_INDEPENDENT_BASE64_32_BYTE_KEY
TOKEN_HASH_KEY_ID=staging-token-hash-key-v1
MFA_ENCRYPTION_KEY=REPLACE_INDEPENDENT_BASE64_32_BYTE_KEY
MFA_ENCRYPTION_KEY_ID=staging-mfa-encryption-key-v1
OUTBOX_ENCRYPTION_KEY=REPLACE_INDEPENDENT_BASE64_32_BYTE_KEY
OUTBOX_ENCRYPTION_KEY_ID=staging-outbox-encryption-key-v1
WEBAUTHN_RP_ID=staging.alliedautotech.com
WEBAUTHN_RP_NAME=Allied AutoTech
WEBAUTHN_ORIGINS=https://staging.alliedautotech.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_DELIVERY_ENABLED=false
SMS_DELIVERY_ENABLED=false
STAGING_EMAIL_ALLOWLIST=
STAGING_SMS_ALLOWLIST=
TERMII_BASE_URL=
TERMII_API_KEY=
TERMII_SENDER_ID=
MESSAGING_REQUEST_TIMEOUT_MS=8000
PAYSTACK_SECRET_KEY=REPLACE_PAYSTACK_TEST_SECRET
